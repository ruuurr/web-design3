rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function validCode(code) { return code.matches('^[A-HJ-NP-Z2-9]{8}$'); }
    function member(data) { return signedIn() && request.auth.uid in data.players.keys(); }
    function host(data) { return signedIn() && data.hostUid == request.auth.uid; }
    function canJoin() {
      return signedIn()
        && !(request.auth.uid in resource.data.players.keys())
        && request.auth.uid in request.resource.data.players.keys()
        && request.resource.data.players.size() <= 8
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players', 'updatedAt'])
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.createdAt == resource.data.createdAt;
    }
    match /rooms/{roomId} {
      // Direct reads support joining by code. Listing all rooms is disabled.
      allow get: if signedIn() && validCode(roomId);
      allow list: if false;
      allow create: if signedIn() && validCode(roomId)
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.players is map
        && request.auth.uid in request.resource.data.players.keys()
        && request.resource.data.players.size() == 1
        && request.resource.data.mode in ['coop', 'competitive']
        && request.resource.data.status == 'playing';
      allow update: if canJoin() || (
        member(resource.data)
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.players is map
        && request.resource.data.players.size() <= 8
        && (
          (host(resource.data) && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['players','answers','playerAnswers','puzzle','puzzleVersion','status','updatedAt','settings','mode']))
          || (!host(resource.data) && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['players','answers','playerAnswers','updatedAt']))
        )
      );
      allow delete: if host(resource.data);
    }
  }
}
